PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LAB_PORTAL_URL=http://127.0.0.1:5173
LAB_API_URL=http://127.0.0.1:3001

# mock or openstack
LAB_PROVIDER=mock
# auto tries Heat first, then falls back to direct Nova if Heat is not in Keystone catalog.
# Use nova when the OpenStack cloud does not run Heat/orchestration.
LAB_OPENSTACK_DEPLOYMENT_MODE=auto
# Optional direct Nova name override for smoke tests.
# LAB_CIRROS_SMOKE_TEST_SERVER_NAME=vm-prueba

# OpenStack Keystone application credential auth.
OS_AUTH_URL=http://openstack.example.local/identity/v3
OS_REGION_NAME=RegionOne
OS_INTERFACE=public
OS_PROJECT_ID=
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=

# Optional if Keystone catalog does not include Heat.
# LAB_HEAT_ENDPOINT=http://openstack.example.local:8004/v1
# Optional for direct Nova deploys when the lab template does not define a network parameter.
# LAB_NOVA_NETWORK=private

# Common Heat template parameters.
# Use LAB_<LAB_SLUG>_... or LAB_<PLATFORM>_... for scoped overrides.
LAB_HEAT_IMAGE=
LAB_HEAT_FLAVOR=
LAB_HEAT_KEY_NAME=
LAB_HEAT_EXTERNAL_NETWORK=
LAB_HEAT_TIMEOUT_MINS=60
LAB_HEAT_DISABLE_ROLLBACK=false
LAB_STACK_POLL_INTERVAL_MS=5000

# Debian smoke test equivalent to:
# openstack server create --flavor m1.small --image "Debian 13 Trixie" --network private vm-prueba
# LAB_PROVIDER=openstack
# LAB_OPENSTACK_DEPLOYMENT_MODE=nova
# LAB_CIRROS_SMOKE_TEST_SERVER_NAME=vm-prueba
# LAB_CIRROS_SMOKE_TEST_PARAM_IMAGE=Debian 13 Trixie
# LAB_CIRROS_SMOKE_TEST_PARAM_FLAVOR=m1.small
# LAB_CIRROS_SMOKE_TEST_PARAM_NETWORK=private

# Splunk single-VM test equivalent to:
# openstack flavor create splunk.large --vcpus 4 --ram 16384 --disk 60
# openstack server create --flavor splunk.large --image "Oracle Linux 9" --network private lab-splunk
# LAB_CCDC_SPLUNK_HEAT_TEMPLATE=heat-templates/single-cirros.yaml
# LAB_CCDC_SPLUNK_PARAM_IMAGE=Oracle Linux 9
# LAB_CCDC_SPLUNK_PARAM_FLAVOR=splunk.large
# LAB_CCDC_SPLUNK_PARAM_NETWORK=private

# Ecom Ubuntu 24 expects the image named "ecom" to already exist in Glance.
# openstack flavor create ecom-3c-4g-50g --vcpus 3 --ram 4096 --disk 50

# Temporary override for testing one deployable template.
# LAB_CCDC_WKST_UBUNTU_24_HEAT_TEMPLATE=heat-templates/single-linux.yaml
