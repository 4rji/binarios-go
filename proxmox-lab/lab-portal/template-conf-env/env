# mock only simulates deployments. Use proxmox to create real VMs.
LAB_PROVIDER=mock
CORS_ORIGIN=*

# Web dev server. npm run dev uses HTTP port 80 by default.
# For npm run dev:443, set WEB_HTTPS_KEY_PATH and WEB_HTTPS_CERT_PATH.
WEB_PORT=80

# Proxmox example:
# LAB_PROVIDER=proxmox
# PROXMOX_API_URL=https://192.168.3.32:8006
# PROXMOX_NODE=pve
# PROXMOX_API_USER=root@pam
# PROXMOX_API_TOKEN_NAME=lab-portal
# PROXMOX_API_TOKEN_VALUE=
# PROXMOX_TEMPLATE_VMID=9000
# PROXMOX_CLONE_FULL=false
# PROXMOX_TLS_INSECURE=true

# Optional per-lab template overrides:
# LAB_CCDC_WEBMAIL_FEDORA_42_PROXMOX_TEMPLATE_VMID=109
# LAB_CCDC_SPLUNK_PROXMOX_TEMPLATE_VMID=104
