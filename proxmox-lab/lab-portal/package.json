{
  "name": "proxmox-lab-portal",
  "version": "0.1.0",
  "private": true,
  "description": "4rji CCDC lab portal web and Electron app.",
  "main": "electron/main.cjs",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web:80\"",
    "dev:80": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web:80\"",
    "dev:443": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web:443\"",
    "dev:api": "npm --workspace backend run dev",
    "dev:web": "npm --workspace frontend run dev",
    "dev:web:5173": "WEB_PORT=5173 npm --workspace frontend run dev",
    "dev:web:80": "WEB_PORT=80 npm --workspace frontend run dev",
    "dev:web:443": "WEB_PORT=443 npm --workspace frontend run dev",
    "dev:desktop": "electron .",
    "start:api": "npm --workspace backend start",
    "build:web": "npm --workspace frontend run build",
    "build:desktop": "npm run build:web && electron-builder",
    "test": "npm --workspace backend test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "dev.proxmox.labportal",
    "productName": "4rji CCDC lab portal",
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "electron/assets",
      "output": "dist-desktop"
    }
  }
}
